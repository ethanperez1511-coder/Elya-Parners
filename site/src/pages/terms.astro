---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const updated = 'June 26, 2026';
---

<Base
  title="Terms & Conditions — Elya Partners"
  description="Elya Partners terms and conditions, including SMS / text messaging program terms."
>
  <Nav variant="application" />

  <!-- HEADER BAND -->
  <section class="app-head">
    <div class="glow"></div>
    <div class="inner">
      <div class="eyebrow"><span class="tick"></span>Legal</div>
      <h1>Terms &amp; <em>conditions.</em></h1>
      <p class="sub">The terms that govern your use of the Elya Partners website and services.</p>
      <p class="updated">Last updated {updated}</p>
    </div>
  </section>

  <article class="legal">
    <section class="lsec">
      <div class="no">01</div>
      <div class="body">
        <h2>Acceptance of terms</h2>
        <p>These Terms &amp; Conditions ("Terms") govern your access to and use of the Elya Partners website and services ("Services"). By using our Services, you agree to these Terms. If you do not agree, please do not use the Services.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">02</div>
      <div class="body">
        <h2>Use of the Services</h2>
        <p>You agree to use the Services only for lawful purposes and to provide accurate, complete information when submitting an inquiry or application. You may not misuse the Services, attempt to disrupt them, or access them in an unauthorized way.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">03</div>
      <div class="body">
        <h2>Applications &amp; financing</h2>
        <p>Submitting an inquiry or application does not constitute approval or a commitment to lend. All financing is subject to review, underwriting, and applicable law. Terms of any financing will be set out in a separate written agreement.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">04</div>
      <div class="body">
        <h2>SMS / text messaging program terms</h2>
        <p>By providing your mobile number and opting in, you consent to receive text messages from Elya Partners related to your inquiry, application, or account — including status updates, customer-care responses, and account notifications.</p>
        <ul>
          <li><b>Message frequency</b> varies based on your interactions with us.</li>
          <li><b>Message and data rates</b> may apply, charged by your carrier.</li>
          <li><b>Opt out</b> at any time by replying <b>STOP</b>. You will receive a final confirmation message.</li>
          <li><b>Help</b> is available by replying <b>HELP</b> or contacting us at the details below.</li>
          <li>Carriers are not liable for delayed or undelivered messages.</li>
        </ul>
        <p class="emphasis">We do not share or sell SMS opt-in data or consent to any third parties for marketing purposes.</p>
        <p>Consent to receive text messages is not a condition of any purchase or financing. See our <a href="/privacy">Privacy Policy</a> for how we handle your information.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">05</div>
      <div class="body">
        <h2>Intellectual property</h2>
        <p>All content on this site — including text, logos, graphics, and design — is the property of Elya Partners or its licensors and is protected by applicable law. You may not copy, reproduce, or distribute it without our written permission.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">06</div>
      <div class="body">
        <h2>Disclaimers</h2>
        <p>The Services are provided "as is" without warranties of any kind, express or implied. We do not guarantee that the Services will be uninterrupted, error-free, or secure. Information on this site is for general purposes and is not financial, legal, or tax advice.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">07</div>
      <div class="body">
        <h2>Limitation of liability</h2>
        <p>To the fullest extent permitted by law, Elya Partners is not liable for any indirect, incidental, or consequential damages arising from your use of the Services.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">08</div>
      <div class="body">
        <h2>Changes &amp; contact</h2>
        <p>We may update these Terms from time to time. Continued use of the Services after changes means you accept the updated Terms. Questions?</p>
        <p class="contact">
          Elya Partners<br />
          66 W Flagler St, Miami, FL 33130<br />
          <a href="mailto:Deals@elyapartners.com">Deals@elyapartners.com</a><br />
          <a href="tel:+17863584675">+1-786-358-4675</a>
        </p>
      </div>
    </section>
  </article>

  <Footer variant="application" />
</Base>

<style>
  .tick { width: 30px; height: 1px; background: var(--gold); }

  /* header band — mirrors apply.astro */
  .app-head {
    background: var(--navy); color: var(--paper); position: relative; overflow: hidden;
    padding: clamp(3rem,6vw,5.5rem) 0 clamp(2.6rem,5vw,4rem);
  }
  .app-head .glow { position: absolute; inset: 0; background: radial-gradient(90% 120% at 92% -10%, rgba(194,160,91,.16), transparent 55%); }
  .app-head .inner { position: relative; z-index: 2; max-width: 1340px; margin: 0 auto; padding-inline: var(--gutter); }
  .app-head .eyebrow { color: var(--gold-soft); display: flex; align-items: center; gap: 1ch; margin-bottom: 1.4rem; }
  .app-head h1 { font-size: clamp(2.6rem,6vw,5rem); font-weight: 360; max-width: 18ch; }
  .app-head h1 em { font-style: italic; color: var(--gold-soft); font-weight: 300; }
  .app-head .sub { margin-top: 1.4rem; max-width: 56ch; color: var(--paper-70); font-weight: 300; font-size: clamp(1.05rem,1.4vw,1.25rem); }
  .app-head .updated { margin-top: 1.4rem; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-soft); }

  /* content */
  .legal {
    max-width: 820px; margin: 0 auto;
    padding: clamp(2.5rem,5vw,4.5rem) var(--gutter) clamp(4rem,8vw,7rem);
  }
  .lsec {
    display: grid; grid-template-columns: 3.2rem 1fr; gap: 1.6rem;
    padding-bottom: clamp(2.2rem,4vw,3rem); margin-bottom: clamp(2.2rem,4vw,3rem);
    border-bottom: 1px solid var(--hair-dark);
  }
  .lsec:last-child { border-bottom: 0; margin-bottom: 0; }
  .lsec .no { font-family: var(--serif); font-size: 1.05rem; color: var(--gold-deep); font-weight: 500; padding-top: .35rem; }
  .lsec h2 { font-size: var(--t-h3); font-weight: 380; margin-bottom: 1.1rem; }
  .lsec .body > p { color: var(--ink-60); margin-bottom: 1rem; }
  .lsec .body > p:last-child { margin-bottom: 0; }
  .lsec ul { margin: 0 0 1rem; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .7rem; color: var(--ink-60); }
  .lsec li { line-height: 1.6; }
  .lsec li::marker { color: var(--gold-deep); }
  .lsec b { color: var(--ink); font-weight: 500; }
  .lsec a { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 3px; }
  .lsec a:hover { color: var(--gold); }

  .emphasis {
    color: var(--ink) !important; font-family: var(--serif); font-style: italic;
    font-size: 1.2rem; line-height: 1.5; font-weight: 340;
    border-left: 2px solid var(--gold); padding-left: 1.2rem; margin: 1.4rem 0 !important;
  }
  .contact { line-height: 1.9; }

  @media (max-width: 600px) {
    .lsec { grid-template-columns: 1fr; gap: .5rem; }
    .lsec .no { padding-top: 0; }
  }
</style>
