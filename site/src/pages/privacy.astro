---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const updated = 'June 26, 2026';
---

<Base
  title="Privacy Policy — Elya Partners"
  description="Elya Partners privacy policy — how we collect, use, and protect your information, including SMS messaging consent."
>
  <Nav variant="application" />

  <!-- HEADER BAND -->
  <section class="app-head">
    <div class="glow"></div>
    <div class="inner">
      <div class="eyebrow"><span class="tick"></span>Legal</div>
      <h1>Privacy <em>policy.</em></h1>
      <p class="sub">How we collect, use, and protect the information you share with Elya Partners.</p>
      <p class="updated">Last updated {updated}</p>
    </div>
  </section>

  <article class="legal">
    <section class="lsec">
      <div class="no">01</div>
      <div class="body">
        <h2>Overview</h2>
        <p>Elya Partners ("Elya Partners," "we," "us," or "our") respects your privacy. This policy explains what information we collect when you visit our website, submit an inquiry, or apply for financing, and how we use and safeguard that information.</p>
        <p>By using our site or submitting information to us, you agree to the practices described in this policy.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">02</div>
      <div class="body">
        <h2>Information we collect</h2>
        <ul>
          <li><b>Contact details</b> — name, business name, email address, phone number, and mailing address.</li>
          <li><b>Application information</b> — details about your business and the capital you request, including documents you choose to upload.</li>
          <li><b>Communications</b> — messages you send us by form, email, phone, or text message.</li>
          <li><b>Usage data</b> — basic analytics such as pages visited, collected through cookies and similar technologies.</li>
        </ul>
      </div>
    </section>

    <section class="lsec">
      <div class="no">03</div>
      <div class="body">
        <h2>How we use your information</h2>
        <ul>
          <li>To evaluate and respond to financing inquiries and applications.</li>
          <li>To communicate with you about your inquiry, application, or account.</li>
          <li>To provide customer support and respond to your requests.</li>
          <li>To meet legal, regulatory, and compliance obligations.</li>
          <li>To improve our website and services.</li>
        </ul>
      </div>
    </section>

    <section class="lsec">
      <div class="no">04</div>
      <div class="body">
        <h2>SMS / text messaging</h2>
        <p>If you provide your mobile number and opt in, we may send text messages related to your inquiry, application, or account — such as status updates and responses to your requests. Message and data rates may apply. Message frequency varies. Reply <b>STOP</b> to cancel or <b>HELP</b> for help.</p>
        <p class="emphasis">We do not share or sell SMS opt-in data or consent to any third parties for marketing purposes.</p>
        <p>Mobile opt-in data and consent are never shared with third parties for their own marketing. See our <a href="/terms">SMS program terms</a> for full details.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">05</div>
      <div class="body">
        <h2>How we share information</h2>
        <p>We do not sell your personal information. We may share information only with:</p>
        <ul>
          <li><b>Service providers</b> who help us operate our business (such as CRM, hosting, and email providers) and who are bound to protect it.</li>
          <li><b>Funding and lending partners</b> as needed to evaluate and fund your application, with your consent.</li>
          <li><b>Authorities</b> when required by law, regulation, or legal process.</li>
        </ul>
      </div>
    </section>

    <section class="lsec">
      <div class="no">06</div>
      <div class="body">
        <h2>Data security &amp; retention</h2>
        <p>We use reasonable administrative, technical, and physical safeguards to protect your information. We retain information for as long as needed to provide our services and to meet legal and regulatory requirements.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">07</div>
      <div class="body">
        <h2>Your choices</h2>
        <p>You may request access to, correction of, or deletion of your personal information, and you may opt out of marketing communications at any time. To exercise these rights, contact us using the details below.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">08</div>
      <div class="body">
        <h2>Contact us</h2>
        <p>Questions about this policy or your information?</p>
        <p class="contact">
          Elya Partners<br />
          66 W Flagler St, Miami, FL 33130<br />
          <a href="mailto:Deals@elyapartners.com">Deals@elyapartners.com</a><br />
          <a href="tel:+17863584675">+1-786-358-4675</a>
        </p>
      </div>
    </section>
  </article>

  <Footer variant="application" />
</Base>

<style>
  .tick { width: 30px; height: 1px; background: var(--gold); }

  /* header band — mirrors apply.astro */
  .app-head {
    background: var(--navy); color: var(--paper); position: relative; overflow: hidden;
    padding: clamp(3rem,6vw,5.5rem) 0 clamp(2.6rem,5vw,4rem);
  }
  .app-head .glow { position: absolute; inset: 0; background: radial-gradient(90% 120% at 92% -10%, rgba(194,160,91,.16), transparent 55%); }
  .app-head .inner { position: relative; z-index: 2; max-width: 1340px; margin: 0 auto; padding-inline: var(--gutter); }
  .app-head .eyebrow { color: var(--gold-soft); display: flex; align-items: center; gap: 1ch; margin-bottom: 1.4rem; }
  .app-head h1 { font-size: clamp(2.6rem,6vw,5rem); font-weight: 360; max-width: 18ch; }
  .app-head h1 em { font-style: italic; color: var(--gold-soft); font-weight: 300; }
  .app-head .sub { margin-top: 1.4rem; max-width: 56ch; color: var(--paper-70); font-weight: 300; font-size: clamp(1.05rem,1.4vw,1.25rem); }
  .app-head .updated { margin-top: 1.4rem; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-soft); }

  /* content */
  .legal {
    max-width: 820px; margin: 0 auto;
    padding: clamp(2.5rem,5vw,4.5rem) var(--gutter) clamp(4rem,8vw,7rem);
  }
  .lsec {
    display: grid; grid-template-columns: 3.2rem 1fr; gap: 1.6rem;
    padding-bottom: clamp(2.2rem,4vw,3rem); margin-bottom: clamp(2.2rem,4vw,3rem);
    border-bottom: 1px solid var(--hair-dark);
  }
  .lsec:last-child { border-bottom: 0; margin-bottom: 0; }
  .lsec .no { font-family: var(--serif); font-size: 1.05rem; color: var(--gold-deep); font-weight: 500; padding-top: .35rem; }
  .lsec h2 { font-size: var(--t-h3); font-weight: 380; margin-bottom: 1.1rem; }
  .lsec .body > p { color: var(--ink-60); margin-bottom: 1rem; }
  .lsec .body > p:last-child { margin-bottom: 0; }
  .lsec ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .7rem; color: var(--ink-60); }
  .lsec li { line-height: 1.6; }
  .lsec li::marker { color: var(--gold-deep); }
  .lsec b { color: var(--ink); font-weight: 500; }
  .lsec a { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 3px; }
  .lsec a:hover { color: var(--gold); }

  .emphasis {
    color: var(--ink) !important; font-family: var(--serif); font-style: italic;
    font-size: 1.2rem; line-height: 1.5; font-weight: 340;
    border-left: 2px solid var(--gold); padding-left: 1.2rem; margin: 1.4rem 0 !important;
  }
  .contact { line-height: 1.9; }

  @media (max-width: 600px) {
    .lsec { grid-template-columns: 1fr; gap: .5rem; }
    .lsec .no { padding-top: 0; }
  }
</style>
