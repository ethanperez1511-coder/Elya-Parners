---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FundingApplication from '../components/FundingApplication.astro';
---

<Base title="Business Application — Elya Partners" leadConnector={false}>
  <Nav variant="application" />

  <!-- HEADER BAND -->
  <section class="app-head">
    <div class="glow"></div>
    <div class="inner">
      <h1>Business <em>application.</em></h1>
      <p class="sub">A few details about your business and financing needs.<br />Apply in about 3 minutes and get immediate attention from our team.</p>
    </div>
  </section>

  <div class="shell" id="formShell">
    <FundingApplication />
  </div>

  <Footer variant="application" />
</Base>

<style>
  /* header band */
  .app-head {
    background: var(--navy); color: var(--paper); position: relative; overflow: hidden;
    padding: clamp(3rem,6vw,5.5rem) 0 clamp(2.6rem,5vw,4rem);
  }
  .app-head .glow { position: absolute; inset: 0; background: radial-gradient(90% 120% at 92% -10%, rgba(194,160,91,.16), transparent 55%); }
  .app-head .inner { position: relative; z-index: 2; max-width: 1340px; margin: 0 auto; padding-inline: var(--gutter); text-align: center; }
  .app-head h1 { font-size: clamp(2.6rem,6vw,5rem); font-weight: 360; max-width: 18ch; margin-inline: auto; }
  .app-head h1 em { font-style: italic; color: var(--gold-soft); font-weight: 300; }
  .app-head .sub { margin: 1.4rem auto 0; max-width: 56ch; color: var(--paper-70); font-weight: 300; font-size: clamp(1.15rem,1.6vw,1.4rem); line-height: 1.6; }

  /* layout */
  .shell {
    max-width: 900px; margin: 0 auto;
    padding: clamp(2.5rem,5vw,4.5rem) var(--gutter) clamp(4rem,8vw,7rem);
  }

</style>
