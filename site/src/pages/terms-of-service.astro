---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const updated = 'July 15, 2026';
---

<Base
  title="FCP Terms of Service"
  description="FCP terms of service — our merchant-support services and SMS messaging program terms."
>
  <Nav variant="application" />

  <!-- HEADER BAND -->
  <section class="app-head">
    <div class="glow"></div>
    <div class="inner">
      <div class="eyebrow"><span class="tick"></span>Legal</div>
      <h1>FCP terms of <em>service.</em></h1>
      <p class="updated">Last updated: {updated}</p>
    </div>
  </section>

  <article class="legal">
    <p class="lede">These Terms of Service govern your use of FCP's website and the merchant-support services provided by FCP ("FCP," "we," "us," or "our").</p>

    <section class="lsec">
      <div class="no">01</div>
      <div class="body">
        <h2>Our Services</h2>
        <p>FCP provides merchant cash advance brokerage services, including personal guidance, assistance with requested applications, follow-ups, responses to merchant questions, and customer success support.</p>
        <p>Funding availability, eligibility, pricing, and transaction terms are determined by the applicable funding provider and its written agreements. Website content and support communications do not constitute a binding funding commitment. Any separate written agreement governing a transaction controls that transaction.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">02</div>
      <div class="body">
        <h2>Your Responsibilities</h2>
        <p>You agree to provide accurate information and to submit business information only when authorized to do so. You agree to use our website and services lawfully and to avoid interfering with their security or operation.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">03</div>
      <div class="body">
        <h2>FCP Merchant Support SMS Program</h2>
        <p>FCP offers optional, individual SMS communications to support merchant clients. Messages may include personal guidance, follow-ups concerning active requests, responses to questions, callback coordination, and customer success assistance.</p>

        <h3>Consent</h3>
        <p>You will receive SMS messages after providing consent to FCP through an available opt-in method. Consent applies to the message types disclosed when you opt in.</p>
        <p>Providing a telephone number or accepting these general Terms of Service does not, by itself, enroll you in SMS messaging. SMS consent is voluntary and is not a condition of purchasing any product or service.</p>

        <h3>Message Frequency</h3>
        <p>Message frequency varies according to your interactions, ongoing requests, and support needs.</p>

        <h3>Message and Data Charges</h3>
        <p>Message and data rates may apply according to your mobile carrier's plan. Contact your carrier for details about applicable charges.</p>

        <h3>Opting Out</h3>
        <p><b>Reply STOP to unsubscribe at any time.</b> You may receive a final message confirming your opt-out. Further messages from this SMS program will stop unless you subsequently provide consent to resume them.</p>
        <p>You may also request an opt-out by calling <a href="tel:+17866002724">(786) 600-2724</a>.</p>

        <h3>Getting Help</h3>
        <p><b>Reply HELP for assistance</b>, or call <a href="tel:+17866002724">(786) 600-2724</a>.</p>

        <h3>Delivery and Availability</h3>
        <p>SMS delivery depends on mobile-network availability and other technical conditions. Delivery and timing are not guaranteed. Carriers are not liable for delayed or undelivered messages.</p>
        <p>If your telephone number changes or you no longer control it, please contact us so we can update your communication preferences.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">04</div>
      <div class="body">
        <h2>Privacy</h2>
        <p>Our <a href="/privacy-policy">Privacy Policy</a> explains how we collect, use, and handle personal information and SMS consent records.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">05</div>
      <div class="body">
        <h2>Third-Party Services</h2>
        <p>Our website or communications may link to funding providers or other third-party services. Those providers maintain their own terms and privacy policies. Review those documents before providing information or entering into an agreement with them.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">06</div>
      <div class="body">
        <h2>Updates to These Terms</h2>
        <p>We may update these Terms of Service and will publish the revised version with its last-updated date. Where required, we will provide additional notice or obtain consent. Changes to these terms do not automatically expand the scope of your existing SMS consent.</p>
      </div>
    </section>

    <section class="lsec">
      <div class="no">07</div>
      <div class="body">
        <h2>Contact Us</h2>
        <p class="contact">
          <b>FCP</b><br />
          Phone: <a href="tel:+17866002724">(786) 600-2724</a><br />
          Business mailing address: 66 W Flagler St, Miami, FL 33130
        </p>
      </div>
    </section>
  </article>

  <Footer variant="application" />
</Base>

<style>
  .tick { width: 30px; height: 1px; background: var(--gold); }

  /* header band — mirrors apply.astro */
  .app-head {
    background: var(--navy); color: var(--paper); position: relative; overflow: hidden;
    padding: clamp(3rem,6vw,5.5rem) 0 clamp(2.6rem,5vw,4rem);
  }
  .app-head .glow { position: absolute; inset: 0; background: radial-gradient(90% 120% at 92% -10%, rgba(194,160,91,.16), transparent 55%); }
  .app-head .inner { position: relative; z-index: 2; max-width: 1340px; margin: 0 auto; padding-inline: var(--gutter); }
  .app-head .eyebrow { color: var(--gold-soft); display: flex; align-items: center; gap: 1ch; margin-bottom: 1.4rem; }
  .app-head h1 { font-size: clamp(2.6rem,6vw,5rem); font-weight: 360; max-width: 18ch; }
  .app-head h1 em { font-style: italic; color: var(--gold-soft); font-weight: 300; }
  .app-head .updated { margin-top: 1.4rem; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-soft); }

  /* content */
  .legal {
    max-width: 800px; margin: 0 auto;
    padding: clamp(2.5rem,5vw,4.5rem) var(--gutter) clamp(4rem,8vw,7rem);
  }
  .legal .lede {
    font-size: 1.1rem; line-height: 1.75; color: var(--ink-60); font-weight: 300;
    padding-bottom: clamp(2.2rem,4vw,3rem); margin-bottom: clamp(2.2rem,4vw,3rem);
    border-bottom: 1px solid var(--hair-dark);
  }
  .lsec {
    display: grid; grid-template-columns: 3.2rem 1fr; gap: 1.6rem;
    padding-bottom: clamp(2.2rem,4vw,3rem); margin-bottom: clamp(2.2rem,4vw,3rem);
    border-bottom: 1px solid var(--hair-dark);
  }
  .lsec:last-child { border-bottom: 0; margin-bottom: 0; }
  .lsec .no { font-family: var(--serif); font-size: 1.05rem; color: var(--gold-deep); font-weight: 500; padding-top: .35rem; }
  .lsec h2 { font-size: var(--t-h3); font-weight: 380; margin-bottom: 1.1rem; }
  .lsec h3 {
    font-family: var(--sans); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold-deep); font-weight: 500; margin: 2rem 0 .9rem;
  }
  .lsec .body > p { color: var(--ink-60); margin-bottom: 1rem; font-size: 1rem; line-height: 1.75; }
  .lsec .body > p:last-child { margin-bottom: 0; }
  .lsec b { color: var(--ink); font-weight: 500; }
  .lsec a { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 3px; }
  .lsec a:hover { color: var(--gold); }
  .contact { line-height: 1.9 !important; }

  @media (max-width: 600px) {
    .lsec { grid-template-columns: 1fr; gap: .5rem; }
    .lsec .no { padding-top: 0; }
  }
</style>
