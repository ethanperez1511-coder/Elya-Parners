---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Elya Partners — Private Business Lending">
  <Nav variant="landing" />

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-bg"><img src="/images/hero-skyline.jpg" alt="Downtown city skyline at dusk" /></div>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-eyebrow eyebrow"><span class="tick"></span>Private Business Lending</div>
      <h1>
        <span class="line"><span>Capital without</span></span>
        <span class="line"><span class="serif-it gold">complexity.</span></span>
      </h1>
      <p class="hero-lead">Elya Partners is a private lender built for growing businesses that need capital quickly and on fair terms — flexible financing aligned with your cash flow and your goals.</p>
      <div class="hero-actions">
        <a class="btn" href="/apply"><span>Apply now</span></a>
        <a class="arrow-link" href="#solutions"><span class="ln">Explore our solutions</span><span class="ar">&rarr;</span></a>
      </div>
    </div>
    <div class="scroll-cue"><span>Scroll</span><span class="bar"></span></div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="marquee">
      <span class="marquee-item">Fast Approvals<span class="dot"></span>Transparent Terms<span class="dot"></span>Asset-Based Lending<span class="dot"></span>Direct Lender Access<span class="dot"></span>Flexible Structures<span class="dot"></span>Client-First Approach<span class="dot"></span></span>
    </div>
  </div>

  <!-- STATS -->
  <section class="stats">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat reveal">
          <div class="val"><span class="count" data-from="0" data-to="24">0</span><span>&ndash;</span><span class="count" data-from="0" data-to="48">0</span><span class="unit">hrs</span></div>
          <div class="lbl">From inquiry to approval decision.</div>
          <div class="rule"></div>
        </div>
        <div class="stat reveal d1">
          <div class="val"><span>Flexible</span></div>
          <div class="lbl">Term structures built around your cash cycle.</div>
          <div class="rule"></div>
        </div>
        <div class="stat reveal d2">
          <div class="val"><span>Direct</span></div>
          <div class="lbl">Work with decision-makers, not middlemen.</div>
          <div class="rule"></div>
        </div>
        <div class="stat reveal d3">
          <div class="val"><span>Transparent</span></div>
          <div class="lbl">Clear terms, no hidden fees.</div>
          <div class="rule"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT 01 -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-tag reveal"><span class="no">01</span><span class="nm">About</span><span class="tline"></span></div>
      <div class="about-grid">
        <div class="about-copy reveal">
          <h2>Pragmatic, asset-minded lending built on <em>trust.</em></h2>
          <div class="paras">
            <p>We provide responsible financing to companies in motion — structured around real assets and real cash flow, not rigid checklists. <strong>Our work begins with understanding your business</strong>, then designing terms that move it forward.</p>
            <p>Collaboration and transparency sit at the center of every relationship. We commit to clear terms, measurable outcomes, and a partnership that respects your time as much as your ambition.</p>
          </div>
        </div>
        <div class="about-media reveal d2">
          <div class="frame"><img src="/images/partners-handshake.jpg" alt="Business partners shaking hands" /></div>
          <div class="badge">Direct<br />Lender</div>
          <div class="cap"><div class="k">Since 2014</div><div class="v">A partner, not a portal.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS 02 -->
  <section class="section" id="solutions">
    <div class="wrap">
      <div class="section-tag reveal"><span class="no">02</span><span class="nm">Solutions</span><span class="tline"></span></div>
      <div class="sol-head">
        <h2 class="reveal">What we offer</h2>
        <p class="sub reveal d1">Four financing structures, each shaped to a different moment in your company's growth — and each underwritten by people who answer the phone.</p>
      </div>
      <div class="sol-grid">
        <article class="sol-card reveal">
          <div class="barline"></div>
          <div class="no">01</div>
          <h3>Asset-Based Lending</h3>
          <p>Leverage inventory, equipment, and real estate to unlock working capital.</p>
          <span class="more">Learn more &rarr;</span>
        </article>
        <article class="sol-card reveal d1">
          <div class="barline"></div>
          <div class="no">02</div>
          <h3>Receivables &amp; Factoring</h3>
          <p>Convert outstanding invoices into immediate cash flow.</p>
          <span class="more">Learn more &rarr;</span>
        </article>
        <article class="sol-card reveal">
          <div class="barline"></div>
          <div class="no">03</div>
          <h3>Equipment Leasing</h3>
          <p>Acquire the equipment you need without depleting reserves.</p>
          <span class="more">Learn more &rarr;</span>
        </article>
        <article class="sol-card reveal d1">
          <div class="barline"></div>
          <div class="no">04</div>
          <h3>Working Capital</h3>
          <p>Bridge gaps, manage seasonality, and seize opportunities as they arrive.</p>
          <span class="more">Learn more &rarr;</span>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="glow"></div>
    <div class="wrap cta-inner">
      <h2 class="reveal">Ready to unlock your business's <em>potential?</em></h2>
      <a class="btn reveal d1" href="/apply"><span>Apply Now</span></a>
    </div>
  </section>

  <!-- CONTACT 03 -->
  <section class="section contact" id="contact">
    <div class="wrap">
      <div class="section-tag reveal"><span class="no">03</span><span class="nm">Contact</span><span class="tline"></span></div>
      <div class="contact-grid">
        <div class="contact-head reveal">
          <h2>Let's discuss what you need.</h2>
          <div class="process">
            <div class="step"><span class="sn">01</span><div><div class="st">Inquiry received</div><div class="sd">Tell us about your business and what you're financing.</div></div></div>
            <div class="step"><span class="sn">02</span><div><div class="st">Evaluation &amp; structuring</div><div class="sd">We assess assets and cash flow, then shape terms to fit.</div></div></div>
            <div class="step"><span class="sn">03</span><div><div class="st">Term sheet issued</div><div class="sd">Clear, transparent terms — no fine print, no surprises.</div></div></div>
            <div class="step"><span class="sn">04</span><div><div class="st">Funded</div><div class="sd">Capital deployed, often within days of agreement.</div></div></div>
          </div>
        </div>
        <form class="form reveal d2" id="inquiryForm" novalidate>
          <div class="form-row">
            <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" type="text" placeholder="Jane Doe" required /></div>
            <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" type="text" placeholder="Acme Holdings" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" placeholder="jane@acme.com" required /></div>
            <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" placeholder="+1 (555) 000-0000" /></div>
          </div>
          <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" placeholder="What are you looking to finance?"></textarea></div>
          <div class="form-foot">
            <p class="note"><span class="pulse"></span>We'll respond within one business day.</p>
            <button class="btn" type="submit"><span id="formBtnLabel">Send Inquiry</span></button>
          </div>
          <p class="form-success" id="formSuccess" style="display:none">Thank you — we'll be in touch within one business day.</p>
          <p class="form-error" id="formError" style="display:none"></p>
        </form>
      </div>
    </div>
  </section>

  <Footer variant="landing" />
</Base>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    color: var(--paper); overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .hero-bg img {
    width: 100%; height: 118%; object-fit: cover; object-position: center 38%;
    will-change: transform;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg img { animation: kenburns 26s ease-in-out infinite alternate; }
  }
  @keyframes kenburns {
    0% { transform: scale(1.02) translateY(0); }
    100% { transform: scale(1.13) translateY(-1.5%); }
  }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(8,19,32,.35) 0%, rgba(8,19,32,.1) 32%, rgba(8,19,32,.25) 64%, rgba(8,19,32,.75) 100%),
      linear-gradient(90deg, rgba(8,19,32,.3) 0%, rgba(8,19,32,.02) 55%);
  }
  .hero-inner {
    position: relative; z-index: 2; width: 100%; max-width: var(--maxw); margin: 0 auto;
    padding: 0 var(--gutter) clamp(4rem,9vh,8rem);
  }
  .hero-eyebrow {
    display: flex; align-items: center; gap: 1.1ch; color: var(--gold-soft);
    margin-bottom: clamp(1.4rem,3vh,2.4rem);
  }
  .tick { width: 34px; height: 1px; background: var(--gold); display: inline-block; }
  .hero h1 {
    font-size: var(--t-hero); max-width: 15ch; font-weight: 380;
    font-optical-sizing: auto;
  }
  .hero h1 .line { display: block; overflow: hidden; padding-bottom: .04em; }
  .hero h1 .line > span { display: block; transform: translateY(110%); }
  .hero-lead {
    margin-top: clamp(1.6rem,3.4vh,2.6rem); max-width: 46ch; color: var(--paper-70);
    font-size: var(--t-lead); font-weight: 300; line-height: 1.55;
  }
  .hero-actions {
    display: flex; align-items: center; gap: clamp(1.5rem,3vw,2.75rem);
    margin-top: clamp(2rem,4vh,3rem); flex-wrap: wrap;
  }
  .scroll-cue {
    position: absolute; left: 50%; bottom: clamp(1.5rem,3vh,2.2rem); transform: translateX(-50%); z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: .7rem; color: var(--paper-45);
    font-size: .62rem; letter-spacing: .3em; text-transform: uppercase;
  }
  .scroll-cue .bar {
    width: 1px; height: 46px; background: linear-gradient(var(--gold), transparent);
    position: relative; overflow: hidden;
  }
  .scroll-cue .bar::after {
    content: ""; position: absolute; top: -46px; left: 0; width: 1px; height: 46px;
    background: var(--paper); animation: cue 2.4s var(--ease) infinite;
  }
  @keyframes cue { 0% { transform: translateY(0); } 100% { transform: translateY(92px); } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue .bar::after { display: none; } }

  /* hero load reveal */
  .hero h1 .line > span { transition: transform 1.05s var(--ease-out); }
  :global(.loaded) .hero h1 .line > span { transform: translateY(0); }
  .hero-eyebrow, .hero-lead, .hero-actions, .scroll-cue {
    opacity: 0; transform: translateY(20px);
    transition: opacity .9s var(--ease), transform .9s var(--ease);
  }
  :global(.loaded) .hero-eyebrow { opacity: 1; transform: none; transition-delay: .15s; }
  :global(.loaded) .hero-lead { opacity: 1; transform: none; transition-delay: .75s; }
  :global(.loaded) .hero-actions { opacity: 1; transform: none; transition-delay: .9s; }
  :global(.loaded) .scroll-cue { opacity: 1; transform: translateX(-50%); transition-delay: 1.2s; }
  @media (prefers-reduced-motion: reduce) {
    .hero h1 .line > span { transform: none; }
    .hero-eyebrow, .hero-lead, .hero-actions { opacity: 1; transform: none; }
  }

  /* ============ MARQUEE ============ */
  .marquee {
    background: var(--navy-900); color: var(--paper); border-block: 1px solid var(--hair-light);
    overflow: hidden; padding: clamp(1.1rem,2vw,1.6rem) 0;
  }
  .marquee-track { display: flex; width: max-content; gap: 0; animation: scrollx 38s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes scrollx { to { transform: translateX(-50%); } }
  .marquee-item {
    display: flex; align-items: center; gap: clamp(1.5rem,3vw,3rem); padding-inline: clamp(1.5rem,3vw,3rem);
    font-family: var(--serif); font-size: clamp(1.1rem,1.7vw,1.6rem); font-weight: 300;
    white-space: nowrap; letter-spacing: .01em;
  }
  .marquee-item .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex: none; }

  /* ============ STATS ============ */
  .stats { background: var(--navy); color: var(--paper); padding: clamp(4rem,8vw,7rem) 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: clamp(.5rem,2vw,2rem) clamp(1.25rem,2.4vw,2.5rem); border-left: 1px solid var(--hair-light); }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .stat .val {
    font-family: var(--serif); font-size: clamp(2.4rem,4.5vw,4rem); font-weight: 340; line-height: 1;
    display: flex; align-items: baseline; gap: .18ch; letter-spacing: -.02em; color: var(--paper);
  }
  .stat .val .unit { font-size: .42em; color: var(--gold-soft); font-style: italic; font-weight: 300; letter-spacing: 0; }
  .stat .lbl { margin-top: 1.1rem; color: var(--paper-45); font-size: .95rem; line-height: 1.5; max-width: 24ch; font-weight: 300; }
  .stat .rule { width: 26px; height: 1px; background: var(--gold); margin-top: 1.4rem; }

  /* ============ SECTIONS (paper) ============ */
  .section { padding: clamp(5rem,11vw,11rem) 0; position: relative; }
  .section-tag {
    display: flex; align-items: baseline; gap: 1.2ch; color: var(--gold-deep);
    margin-bottom: clamp(2rem,4vw,3.5rem);
  }
  .section-tag .no { font-family: var(--serif); font-size: 1rem; font-weight: 500; letter-spacing: .05em; }
  .section-tag .nm { font-size: var(--t-eyebrow); letter-spacing: .32em; text-transform: uppercase; color: var(--ink-60); font-weight: 500; }
  .section-tag .tline { flex: 1; height: 1px; background: var(--hair-dark); max-width: 0; transition: max-width 1.1s var(--ease); }
  :global(.reveal.in) .section-tag .tline,
  .section-tag:is(.in) .tline { max-width: 240px; }

  /* About */
  .about-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2.5rem,6vw,6rem); align-items: center; }
  .about-copy h2 { font-size: var(--t-h2); max-width: 16ch; font-weight: 360; }
  .about-copy h2 em { font-style: italic; color: var(--gold-deep); font-weight: 300; }
  .about-copy .paras { margin-top: clamp(1.8rem,3vw,2.5rem); display: flex; flex-direction: column; gap: 1.4rem; max-width: 48ch; }
  .about-copy p { color: var(--ink-60); font-weight: 400; }
  .about-copy p strong { color: var(--ink); font-weight: 500; }
  .about-media { position: relative; }
  .about-media .frame { position: relative; overflow: hidden; aspect-ratio: 4/5; background: var(--navy-800); }
  .about-media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(1.02); transition: transform 1.4s var(--ease-out); }
  .about-media:hover img { transform: scale(1.04); }
  .about-media .frame::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(150deg, rgba(11,26,43,.12), rgba(11,26,43,.42)); mix-blend-mode: multiply;
  }
  .about-media .cap {
    position: absolute; left: 0; bottom: 0; z-index: 2; background: var(--navy); color: var(--paper);
    padding: 1.4rem 1.8rem; max-width: 62%;
  }
  .about-media .cap .k { font-size: var(--t-eyebrow); letter-spacing: .28em; text-transform: uppercase; color: var(--gold-soft); }
  .about-media .cap .v { font-family: var(--serif); font-size: 1.35rem; font-weight: 300; margin-top: .5rem; line-height: 1.2; }
  .about-media .badge {
    position: absolute; top: -22px; right: -10px; z-index: 2; width: 120px; height: 120px; border-radius: 50%;
    border: 1px solid var(--gold); color: var(--gold-deep); display: grid; place-items: center; text-align: center;
    background: var(--paper); font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; line-height: 1.5;
  }

  /* Solutions */
  .sol-head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap;
    margin-bottom: clamp(2.5rem,5vw,4rem);
  }
  .sol-head h2 { font-size: var(--t-h2); max-width: 14ch; font-weight: 360; }
  .sol-head .sub { max-width: 34ch; color: var(--ink-60); }
  .sol-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.5rem,3vw,3rem) clamp(2rem,5vw,5rem); }
  .sol-card {
    position: relative; padding: clamp(2rem,3.2vw,3rem) 0 clamp(2.2rem,3.4vw,3.2rem);
    border-top: 1px solid var(--hair-dark); transition: transform .5s var(--ease-out);
  }
  .sol-card .barline {
    position: absolute; top: -1px; left: 0; height: 2px; width: 100%; background: var(--gold);
    transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease);
  }
  .sol-card:hover { transform: translateY(-8px); }
  .sol-card:hover .barline { transform: scaleX(1); }
  .sol-card .no { font-family: var(--serif); font-size: 1rem; color: var(--gold-deep); font-weight: 500; letter-spacing: .06em; }
  .sol-card h3 { font-size: var(--t-h3); margin-top: 1.4rem; font-weight: 380; transition: color .4s var(--ease); }
  .sol-card:hover h3 { color: var(--navy-700); }
  .sol-card p { margin-top: 1rem; color: var(--ink-60); max-width: 36ch; font-weight: 400; }
  .sol-card .more {
    margin-top: 1.6rem; display: inline-flex; align-items: center; gap: .7ch;
    font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-deep);
    opacity: 0; transform: translateY(6px); transition: opacity .45s var(--ease), transform .45s var(--ease);
  }
  .sol-card:hover .more { opacity: 1; transform: none; }

  /* CTA band */
  .cta { background: var(--navy-900); color: var(--paper); position: relative; overflow: hidden; }
  .cta .glow { position: absolute; inset: 0; background: radial-gradient(120% 90% at 80% 110%, rgba(194,160,91,.16), transparent 60%); }
  .cta-inner {
    position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between;
    gap: clamp(2rem,5vw,5rem); flex-wrap: wrap; padding-block: clamp(4.5rem,9vw,8rem);
  }
  .cta h2 { font-size: var(--t-h2); max-width: 18ch; font-weight: 340; }
  .cta h2 em { font-style: italic; color: var(--gold-soft); font-weight: 300; }

  /* Contact */
  .contact { background: var(--paper-2); }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem,7vw,7rem); align-items: start; }
  .contact-head h2 { font-size: var(--t-h2); max-width: 13ch; margin-bottom: clamp(2.5rem,5vw,4rem); font-weight: 360; }
  .process { display: flex; flex-direction: column; }
  .step { display: flex; gap: 1.6rem; padding: 1.6rem 0; border-top: 1px solid var(--hair-dark); position: relative; }
  .step:last-child { border-bottom: 1px solid var(--hair-dark); }
  .step .sn { font-family: var(--serif); font-size: 1.5rem; color: var(--gold-deep); font-weight: 400; min-width: 2.2ch; line-height: 1; }
  .step .st { font-family: var(--serif); font-size: clamp(1.2rem,1.9vw,1.55rem); font-weight: 340; line-height: 1.2; }
  .step .sd { margin-top: .4rem; color: var(--ink-60); font-size: .95rem; }

  @media (max-width: 980px) {
    .stats-grid { grid-template-columns: 1fr 1fr; gap: 0; }
    .stat { border-top: 1px solid var(--hair-light); padding: 2rem 1.5rem; }
    .stat:first-child { border-left: 0; padding-left: 1.5rem; }
    .stat:nth-child(odd) { border-left: 0; padding-left: 0; }
    .stat:nth-child(-n+2) { border-top: 0; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-media { max-width: 480px; }
    .sol-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; gap: 3.5rem; }
  }
  /* Form */
  .form { background: var(--navy); color: var(--paper); padding: clamp(2.2rem,4vw,3.4rem); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .field { display: flex; flex-direction: column; margin-bottom: 1.6rem; }
  .field label { font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--paper-45); margin-bottom: .7rem; }
  .field input, .field textarea {
    background: transparent; border: 0; border-bottom: 1px solid var(--hair-light); color: var(--paper);
    font-family: var(--sans); font-size: 1rem; padding: .6rem 0; outline: none; transition: border-color .4s var(--ease);
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--paper-45); }
  .field input:focus, .field textarea:focus { border-color: var(--gold); }
  .field textarea { resize: vertical; min-height: 90px; }
  .field input.invalid, .field textarea.invalid { border-color: #b5503a; }
  .form .note { margin-top: .4rem; color: var(--paper-45); font-size: .85rem; display: flex; align-items: center; gap: .7ch; }
  .form .note .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 rgba(194,160,91,.6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(194,160,91,.55); } 70% { box-shadow: 0 0 0 8px rgba(194,160,91,0); } 100% { box-shadow: 0 0 0 0 rgba(194,160,91,0); } }
  .form-foot { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: .8rem; flex-wrap: wrap; }
  .form-success { color: var(--gold-soft); margin-top: 1.2rem; font-family: var(--serif); font-size: 1.1rem; }
  .form-error { color: #b5503a; margin-top: 1rem; font-size: .9rem; }

  @media (max-width: 680px) {
    .stats-grid { grid-template-columns: 1fr; }
    .stat, .stat:first-child { border-left: 0; padding: 1.8rem 0; border-top: 1px solid var(--hair-light); }
    .stat:first-child { border-top: 0; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<script>
  (function(){
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero load reveal
    window.addEventListener('load', () => {
      requestAnimationFrame(() => document.body.classList.add('loaded'));
    });
    setTimeout(() => document.body.classList.add('loaded'), 1200);

    // Nav solid on scroll
    const nav = document.getElementById('nav');
    function onScroll() {
      if (!nav) return;
      const threshold = window.innerHeight * 0.82;
      nav.classList.toggle('scrolled', window.scrollY > threshold);
    }
    onScroll();

    // Hero parallax
    const heroImg = document.querySelector('.hero-bg img') as HTMLImageElement | null;
    let ticking = false;
    function parallax() {
      if (reduce || !heroImg) return;
      const y = window.scrollY;
      if (y < window.innerHeight) {
        heroImg.style.transform = `translateY(${y * 0.28}px)`;
      }
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { onScroll(); parallax(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    // Duplicate marquee content for seamless loop
    const mq = document.getElementById('marquee');
    if (mq?.firstElementChild) {
      mq.appendChild(mq.firstElementChild.cloneNode(true));
    }

    // Scroll reveal + section tag lines
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal, .section-tag').forEach((el) => io.observe(el));

    // Count up
    function animateCount(el: Element) {
      const htmlEl = el as HTMLElement;
      const to = parseInt(htmlEl.getAttribute('data-to') || '0', 10);
      const from = parseInt(htmlEl.getAttribute('data-from') || '0', 10);
      if (reduce) { htmlEl.textContent = String(to); return; }
      const dur = 1500;
      let start: number | null = null;
      function step(ts: number) {
        if (!start) start = ts;
        const p = Math.min((ts - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        htmlEl.textContent = String(Math.round(from + (to - from) * eased));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    const countIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.querySelectorAll('.count').forEach(animateCount);
          countIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('.stat').forEach((s) => {
      if (s.querySelector('.count')) countIO.observe(s);
    });

    // Magnetic buttons
    if (!reduce && window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('.btn').forEach((btn) => {
        const el = btn as HTMLElement;
        el.addEventListener('mousemove', (ev: MouseEvent) => {
          const r = el.getBoundingClientRect();
          const mx = ev.clientX - r.left - r.width / 2;
          const my = ev.clientY - r.top - r.height / 2;
          el.style.transform = `translate(${mx * 0.18}px, ${my * 0.28}px)`;
        });
        el.addEventListener('mouseleave', () => { el.style.transform = ''; });
      });
    }

    // Mobile menu
    const menu = document.getElementById('mobileMenu');
    const toggle = document.getElementById('navToggle');
    const closeBtn = document.getElementById('menuClose');
    function openMenu() { menu?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeMenu() { menu?.classList.remove('open'); document.body.style.overflow = ''; }
    toggle?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    menu?.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', closeMenu));

    // Inquiry form submission
    const inquiryForm = document.getElementById('inquiryForm') as HTMLFormElement | null;
    inquiryForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formEl = e.target as HTMLFormElement;
      const btn = formEl.querySelector('.btn') as HTMLButtonElement;
      const label = document.getElementById('formBtnLabel')!;
      const successEl = document.getElementById('formSuccess')!;
      const errorEl = document.getElementById('formError')!;

      // Clear previous state
      formEl.querySelectorAll('.invalid').forEach(el => el.classList.remove('invalid'));
      successEl.style.display = 'none';
      errorEl.style.display = 'none';

      // Validate
      const name = (formEl.querySelector('[name="name"]') as HTMLInputElement).value.trim();
      const email = (formEl.querySelector('[name="email"]') as HTMLInputElement).value.trim();
      let valid = true;
      if (!name) { formEl.querySelector('[name="name"]')!.classList.add('invalid'); valid = false; }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { formEl.querySelector('[name="email"]')!.classList.add('invalid'); valid = false; }
      if (!valid) return;

      const data = Object.fromEntries(new FormData(formEl));

      label.textContent = 'Sending…';
      btn.disabled = true;

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Something went wrong.');
        formEl.reset();
        successEl.style.display = 'block';
      } catch (err: any) {
        errorEl.textContent = err.message || 'Something went wrong. Please try again.';
        errorEl.style.display = 'block';
      } finally {
        label.textContent = 'Send Inquiry';
        btn.disabled = false;
      }
    });

  })();
</script>
