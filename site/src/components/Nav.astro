---
import logo from '../../public/elya-logo.svg?raw';

interface Props {
  variant?: 'landing' | 'application';
}
const { variant = 'landing' } = Astro.props;
---

{variant === 'landing' ? (
  <header class="nav" id="nav">
    <a class="brand" href="#top" aria-label="Elya Partners"><span class="brand-logo" aria-hidden="true" set:html={logo} /></a>
    <nav class="nav-links">
      <a href="#about">About</a>
      <a href="#solutions">Solutions</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="nav-right">
      <a class="btn btn-nav" href="/apply"><span>Apply now</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu">
        <svg width="26" height="14" viewBox="0 0 26 14" fill="none"><path d="M0 1h26M0 13h18" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu">
    <button class="close" id="menuClose" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
    <nav class="nav-links">
      <a href="#about" data-close>About</a>
      <a href="#solutions" data-close>Solutions</a>
      <a href="#contact" data-close>Contact</a>
    </nav>
    <a class="btn" href="/apply" data-close><span>Apply now</span></a>
  </div>
) : (
  <header class="nav nav--app">
    <a class="brand" href="/" aria-label="Elya Partners"><span class="brand-logo brand-logo--app" aria-hidden="true" set:html={logo} /></a>
    <a class="back" href="/"><span class="ar">&larr;</span> Back to site</a>
  </header>
)}

<style>
  /* Landing nav */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 2rem; min-height: 92px;
    padding: 1rem clamp(1.25rem, 3.3vw, 3rem);
    color: var(--white);
    background: linear-gradient(180deg, color-mix(in srgb, var(--navy-900) 48%, transparent), transparent);
    transition: background .55s var(--ease), padding .55s var(--ease), box-shadow .55s var(--ease), border-color .55s var(--ease);
    border-bottom: 0;
  }
  .nav.scrolled {
    background: rgba(8,19,32,.86);
    -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 0;
    padding-top: 1rem; padding-bottom: 1rem;
  }

  /* App nav */
  .nav--app {
    position: sticky; top: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding: 1.1rem var(--gutter);
    background: rgba(8,19,32,.92);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    color: var(--paper);
    border-bottom: 1px solid var(--hair-light);
  }
  .nav--app .brand { font-size: 1.3rem; }

  .brand {
    display: flex; align-items: center;
  }
  .brand-logo {
    height: clamp(36px, 4vw, 48px); width: auto; display: block;
    aspect-ratio: 1590 / 547.29;
  }
  .brand-logo :global(svg) { display: block; width: 100%; height: 100%; }
  .brand-logo--app {
    height: 38px;
  }

  .nav-links { display: flex; gap: 2.25rem; align-items: center; }
  .nav-links a {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 1rem; letter-spacing: .01em; font-weight: 500;
    position: relative; color: var(--white); transition: color .3s var(--ease);
  }
  .nav-links a::after {
    content: ""; position: absolute; left: 0; bottom: 4px; height: 1px; width: 0; background: var(--gold);
    transition: width .4s var(--ease);
  }
  .nav-links a:hover { color: var(--paper); }
  .nav-links a:hover::after { width: 100%; }
  .nav > .nav-links { gap: var(--s1); }
  .nav > .nav-links a {
    justify-content: center;
    padding: var(--s1) var(--s2);
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--hair-light) 30%, transparent);
    transition: background .3s var(--ease), border-color .3s var(--ease), color .3s var(--ease);
  }
  .nav > .nav-links a::after { display: none; }
  .nav > .nav-links a:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--hair-light) 65%, transparent);
    border-color: var(--hair-light);
    color: var(--white);
  }
  .nav > .nav-links a:active { background: var(--hair-light); }
  .nav-right :global(.btn-nav) {
    min-width: calc(var(--s6) * 2);
    padding-inline: var(--s4);
  }
  .nav-right { display: flex; justify-self: end; align-items: center; gap: 1rem; }
  .nav-toggle { display: none; min-width: 44px; min-height: 44px; background: none; border: 0; color: var(--paper); cursor: pointer; padding: .5rem; }
  .nav-toggle svg { display: block; }

  .back {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--paper-70);
    display: inline-flex; align-items: center; gap: .7ch; transition: color .3s var(--ease);
  }
  .back:hover { color: var(--paper); }
  .back .ar { transition: transform .35s var(--ease); }
  .back:hover .ar { transform: translateX(-5px); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 1500; background: var(--navy-900); color: var(--paper);
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: .5rem;
    padding: var(--gutter); visibility: hidden; transform: translateX(100%); transition: transform .55s var(--ease), visibility .55s;
  }
  .mobile-menu.open { visibility: visible; transform: none; }
  .mobile-menu .nav-links { flex-direction: column; align-items: flex-start; gap: 1.6rem; }
  .mobile-menu .nav-links a {
    font-family: var(--sans); font-size: 2rem; text-transform: none; letter-spacing: 0; color: var(--paper);
  }
  .mobile-menu .close {
    position: absolute; top: var(--gutter); right: var(--gutter);
    display: grid; place-items: center;
    min-width: 44px; min-height: 44px; padding: var(--s1);
    background: none; border: 0; color: var(--paper); cursor: pointer;
  }
  .mobile-menu :global(.btn) { margin-top: 2rem; }

  @media (max-width: 820px) {
    .nav { display: flex; justify-content: space-between; gap: 1rem; min-height: 80px; }
    /* Keep the header in initial document layout on mobile, while retaining
       its overlay position over the hero and its visibility during scrolling. */
    .nav:not(.nav--app) {
      position: sticky; top: 0;
      height: calc(var(--s5) + var(--s2));
      margin-bottom: calc(-1 * (var(--s5) + var(--s2)));
      padding-inline: var(--gutter);
    }
    .nav-links, .nav-right :global(.btn) { display: none; }
    .nav-toggle { display: block; }
    .mobile-menu .nav-links { display: flex; }
  }
</style>
