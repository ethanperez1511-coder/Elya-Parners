---
interface Props {
  variant?: 'landing' | 'application';
}
const { variant = 'landing' } = Astro.props;
---

{variant === 'landing' ? (
  <header class="nav" id="nav">
    <a class="brand" href="#top"><img src="/elya-logo.svg" alt="Elya Partners" class="brand-logo" /></a>
    <nav class="nav-links">
      <a href="#about">About</a>
      <a href="#solutions">Solutions</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="nav-right">
      <a class="btn btn-nav" href="/apply"><span>Apply Now</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu">
        <svg width="26" height="14" viewBox="0 0 26 14" fill="none"><path d="M0 1h26M0 13h18" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu">
    <button class="close" id="menuClose" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
    <nav class="nav-links">
      <a href="#about" data-close>About</a>
      <a href="#solutions" data-close>Solutions</a>
      <a href="#contact" data-close>Contact</a>
    </nav>
    <a class="btn" href="/apply" data-close><span>Apply Now</span></a>
  </div>
) : (
  <header class="nav nav--app">
    <a class="brand" href="/"><img src="/elya-logo.svg" alt="Elya Partners" class="brand-logo brand-logo--app" /></a>
    <a class="back" href="/"><span class="ar">&larr;</span> Back to site</a>
  </header>
)}

<style>
  /* Landing nav */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--s4);
    padding: clamp(1.1rem,2vw,1.6rem) var(--gutter);
    color: var(--paper);
    transition: background .55s var(--ease), padding .55s var(--ease), box-shadow .55s var(--ease), border-color .55s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(8,19,32,.86);
    -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--hair-light);
    padding-top: clamp(.8rem,1.3vw,1.05rem); padding-bottom: clamp(.8rem,1.3vw,1.05rem);
  }

  /* App nav */
  .nav--app {
    position: sticky; top: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding: 1.1rem var(--gutter);
    background: rgba(8,19,32,.92);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    color: var(--paper);
    border-bottom: 1px solid var(--hair-light);
  }
  .nav--app .brand { font-size: 1.3rem; }

  .brand {
    display: flex; align-items: center;
  }
  .brand-logo {
    height: clamp(36px, 4vw, 48px); width: auto; display: block;
  }
  .brand-logo--app {
    height: 38px;
  }

  .nav-links { display: flex; gap: clamp(1.5rem,2.6vw,2.75rem); align-items: center; }
  .nav-links a {
    font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 400;
    position: relative; color: var(--paper-70); transition: color .3s var(--ease);
  }
  .nav-links a::after {
    content: ""; position: absolute; left: 0; bottom: -6px; height: 1px; width: 0; background: var(--gold);
    transition: width .4s var(--ease);
  }
  .nav-links a:hover { color: var(--paper); }
  .nav-links a:hover::after { width: 100%; }
  .nav-right { display: flex; align-items: center; gap: clamp(1.25rem,2.4vw,2.5rem); }
  .nav-toggle { display: none; background: none; border: 0; color: var(--paper); cursor: pointer; padding: .4rem; }
  .nav-toggle svg { display: block; }

  .back {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--paper-70);
    display: inline-flex; align-items: center; gap: .7ch; transition: color .3s var(--ease);
  }
  .back:hover { color: var(--paper); }
  .back .ar { transition: transform .35s var(--ease); }
  .back:hover .ar { transform: translateX(-5px); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 1500; background: var(--navy-900); color: var(--paper);
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: .5rem;
    padding: var(--gutter); transform: translateX(100%); transition: transform .55s var(--ease);
  }
  .mobile-menu.open { transform: none; }
  .mobile-menu .nav-links { flex-direction: column; align-items: flex-start; gap: 1.6rem; }
  .mobile-menu .nav-links a {
    font-family: var(--serif); font-size: 2rem; text-transform: none; letter-spacing: 0; color: var(--paper);
  }
  .mobile-menu .close {
    position: absolute; top: var(--gutter); right: var(--gutter);
    background: none; border: 0; color: var(--paper); cursor: pointer;
  }
  .mobile-menu :global(.btn) { margin-top: 2rem; }

  @media (max-width: 680px) {
    .nav-links, .nav-right :global(.btn) { display: none; }
    .nav-toggle { display: block; }
    .mobile-menu .nav-links { display: flex; }
  }
</style>
